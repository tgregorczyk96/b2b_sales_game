# B2B Sales Simulator (Unity client) – local configuration template.
#
# Copy this file to .env (same folder) and put your real values there:
#   Copy-Item .env.example .env
# .env is git-ignored. Never put real keys into this .env.example.
#
# Variable names are exactly those of the Sales Engine (sales_engine/.env.example), because the engine's
# LlmOptions reads them. Only what the Unity client needs (now or foreseeably) is listed here.
#
# Prepared only: nothing in Unity loads this file yet, and the Anthropic customer is not active in Unity yet.

# Anthropic (active LLM provider)
SALESSIM_ANTHROPIC_API_KEY=
# Optional: empty = the engine's default model.
SALESSIM_ANTHROPIC_MODEL=

# Shared
# Optional: empty = the engine's default (30 seconds).
SALESSIM_AI_TIMEOUT_SECONDS=
