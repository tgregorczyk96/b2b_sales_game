# Crash reports / builds
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-buildid.txt

# OS
.DS_Store
Thumbs.db

# Secrets: local env files stay local; only the example is versioned
.env
.env.*
!.env.example
